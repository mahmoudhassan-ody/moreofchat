[importlinter]
root_package = moc
include_external_packages = True

[importlinter:contract:provider-sdk-isolation]
name = Provider SDKs only inside their adapters
type = forbidden
source_modules =
    moc.api
    moc.agent
    moc.retrieval
    moc.arabic
    moc.tenancy
    moc.verticals
    moc.workers
    moc.evals
forbidden_modules =
    anthropic
    openai
    twilio

[importlinter:contract:vector-store-isolation]
name = Qdrant and Meilisearch only inside the retrieval adapters
type = forbidden
source_modules =
    moc.api
    moc.agent
    moc.arabic
    moc.tenancy
    moc.verticals
    moc.workers
    moc.evals
forbidden_modules =
    qdrant_client
    meilisearch

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    moc.workers
    moc.api
    moc.channels
    moc.agent
    moc.retrieval
    moc.llm
    moc.tenancy

# The eval harness runs the agent, so the dependency points evals -> agent.
# `check_numeric_grounding` lives in moc.agent.guards for that reason: it is a
# runtime gate the orchestrator enforces, which the harness then measures.
# Without this contract someone reasonably moves it back into moc.evals, the
# import becomes a cycle, and the fix that unblocks them is a second copy —
# at which point the eval suite can pass while production emits an orphan.
[importlinter:contract:evals-are-downstream-of-the-agent]
name = The agent never imports the eval harness
type = forbidden
source_modules =
    moc.agent
    moc.arabic
    moc.channels
    moc.llm
    moc.retrieval
    moc.tenancy
forbidden_modules =
    moc.evals

# §11: the webhook verifies, resolves, enqueues and returns. Both vendors retry
# anything that is not a prompt 2xx, so a slow ACK is not a latency problem —
# it is a duplicate delivery, and the customer gets answered twice. The handler
# cannot be slow if it cannot reach anything slow.
[importlinter:contract:webhook-does-no-slow-work]
name = The webhook layer never reaches a model or the agent
type = forbidden
source_modules =
    moc.channels
forbidden_modules =
    moc.agent
    moc.llm

# §7.2: one collection holds every tenant's points, so the tenant filter is
# the only thing separating them — and its absence has no behavioural
# signature. Every module that can import the client is another place a filter
# can be forgotten, so exactly one may.
#
# Stated as "forbidden everywhere, ignored for one module" rather than by
# listing the packages that may not import it: a new package added later is
# then covered by default instead of being covered only if someone remembers
# to add it here.
[importlinter:contract:qdrant-client-in-one-module]
name = The Qdrant client is imported only by the vector repository
type = forbidden
source_modules =
    moc
forbidden_modules =
    qdrant_client
ignore_imports =
    moc.retrieval.vectors -> qdrant_client

# Nothing in moc imports the Meilisearch SDK at all — `lexical.py` takes an
# injected client and uses only its call shape, so it needs no import and no
# exemption. Stated as a contract rather than left implicit because the first
# person to want `AsyncClient` for a type hint will add the import without
# noticing they have widened the surface; this makes that a deliberate edit
# here rather than a quiet one there.
#
# Contrast with Qdrant, where `vectors.py` genuinely needs `models` to build a
# filter and therefore carries an explicit exemption.
[importlinter:contract:meilisearch-client-is-injected-not-imported]
name = The Meilisearch SDK is imported nowhere in moc
type = forbidden
source_modules =
    moc
forbidden_modules =
    meilisearch_python_sdk

# Task 22. An agent's reply is a message to a customer on a messaging
# platform, so it is subject to the same rate limit and the same 24-hour
# service window as a bot reply (§6.2). The inbox therefore publishes an
# `OutboundJob` and the existing sender worker delivers it.
#
# The layered contract does not cover this: `moc.api -> moc.channels` is a
# legal direction, so importing the Twilio adapter here breaks nothing it
# checks. But a second send path means a second token bucket — and two buckets
# each allowing the full rate is the same as no limit — and a second place for
# the window rule to be wrong, on the path where it is most likely to be:
# an agent replies to a conversation that has been queued, which is exactly
# when the window has expired.
#
# The queue adapter is forbidden for the same reason from the other side: the
# publisher is a port, injected by the composition root, so that "one send
# path" is a property of the wiring rather than a habit.
[importlinter:contract:one-send-path]
name = The agent inbox never reaches a channel adapter or the queue directly
type = forbidden
source_modules =
    moc.api.inbox
# Every adapter, enumerated. A forbidden contract on `moc.channels` as a
# whole would also forbid `moc.channels.base`, which is where `OutboundJob`
# lives and is exactly what the inbox is supposed to use — so the list is
# per adapter, and a new channel has to be added here by whoever adds it.
forbidden_modules =
    moc.channels.twilio_wa
    moc.channels.telegram
    moc.channels.meta
    moc.channels.sendgrid_email
    moc.channels.valkey
    moc.workers
